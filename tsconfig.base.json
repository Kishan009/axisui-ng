{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@axisui-ng/angular": ["./libs/ui/src/index.ts"],
      "@axisui-ng/angular/*": ["./libs/*/src/index.ts"],
      "@axisui-ng/primitives": ["./libs/primitives/src/index.ts"],
      "@axisui-ng/buttons": ["./libs/buttons/src/index.ts"],
      "@axisui-ng/forms": ["./libs/forms/src/index.ts"],
      "@axisui-ng/data": ["./libs/data/src/index.ts"],
      "@axisui-ng/feedback": ["./libs/feedback/src/index.ts"],
      "@axisui-ng/overlays": ["./libs/overlays/src/index.ts"],
      "@axisui-ng/overlays-core": ["./libs/overlays-core/src/index.ts"],
      "@axisui-ng/overlays/dialog": ["./libs/overlays/src/lib/dialog/index.ts"],
      "@axisui-ng/overlays/menu": ["./libs/overlays/src/lib/menu/index.ts"],
      "@axisui-ng/overlays/hover-card": ["./libs/overlays/src/lib/hover-card/index.ts"],
      "@axisui-ng/overlays/context-menu": ["./libs/overlays/src/lib/context-menu/index.ts"],
      "@axisui-ng/overlays/popover": ["./libs/overlays/src/lib/popover/index.ts"],
      "@axisui-ng/overlays/sheet": ["./libs/overlays/src/lib/sheet/index.ts"],
      "@axisui-ng/overlays/tooltip": ["./libs/overlays/src/lib/tooltip/index.ts"],
      "@axisui-ng/navigation": ["./libs/navigation/src/index.ts"],
      "@axisui-ng/misc": ["./libs/misc/src/index.ts"],
      "@axisui-ng/flow": ["./libs/flow/src/index.ts"],
      "@axisui-ng/cdk": ["./libs/cdk/src/index.ts"],
      "@axisui-ng/tree": ["./libs/tree/src/index.ts"],
      "@axisui-ng/layout": ["./libs/layout/src/index.ts"],
      "@axisui-ng/blocks": ["./libs/blocks/src/index.ts"],
      "@axisui-ng/charts": ["./libs/charts/src/index.ts"],
      "@axisui-ng/icons": ["./libs/icons/src/index.ts"],
      "@axisui-ng/themes": ["./libs/themes/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", ".nx", "**/*.spec.ts"]
}
