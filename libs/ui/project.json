{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib", "role:meta", "license:mit"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/ui/ng-package.json",
        "tsConfig": "libs/ui/tsconfig.lib.json"
      }
    },
    "build-schematics": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/ui/schematics"],
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "tsc -p libs/ui/schematics/tsconfig.json",
          "node -e \"const fs=require('fs');fs.mkdirSync('dist/libs/ui/schematics/ng-add',{recursive:true});fs.copyFileSync('libs/ui/schematics/collection.json','dist/libs/ui/schematics/collection.json');fs.copyFileSync('libs/ui/schematics/ng-add/schema.json','dist/libs/ui/schematics/ng-add/schema.json')\""
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ui/jest.config.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
