{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": "../../../dist/libs/ui/schematics",
    "rootDir": "."
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
