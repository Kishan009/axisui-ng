{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": ["node"],
    "lib": ["dom", "es2022"]
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "exclude": ["**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
