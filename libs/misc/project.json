{
  "name": "misc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/misc/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib", "role:category", "license:mit"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": { "project": "libs/misc/ng-package.json", "tsConfig": "libs/misc/tsconfig.lib.json" }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "libs/misc/jest.config.js" }
    },
    "lint": { "executor": "@nx/eslint:lint", "outputs": ["{options.outputFile}"] }
  }
}
